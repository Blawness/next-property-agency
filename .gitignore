# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
references/

# raw hero source — keep out of git; regenerate optimized outputs via scripts/encode-hero.sh
/public/hero.mp4
# hero.av1.mp4 + hero.webm are the optimized outputs referenced by the hero <video>;
# they MUST be committed so Vercel can serve them (no CDN setup required).

# local analysis tooling output — keep on disk, not in git
/.scan-report/
/suggest-reports/
